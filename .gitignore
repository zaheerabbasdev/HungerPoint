# Root-level safety net — each app folder has its own more specific .gitignore.
# This just covers what the root package.json's scripts could create here.
node_modules/

# Mobile release builds (build-mobile-release.ps1)
release/

# Local-only deployment notes (not for GitHub)
DEPLOYMENT.md

# Secrets / env copies without the leading dot (not covered by .env* rules)
hpbackend/env
hpbackend/env.production
hpbackend/env.godaddy

# Database dumps (contain user accounts and password hashes)
req/
*.sql
