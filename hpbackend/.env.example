# HungerPoint Backend Environment Variables — template
#
# Copy this file to `.env` and it works immediately for local development
# (as long as your local MySQL — WAMP/XAMPP — is running and has an empty
# `hungerpointdb` database created). The values below are dev-only defaults,
# not secrets worth protecting — generate fresh ones before any real
# deployment (see the JWT section). `.env` itself is gitignored and never
# committed — this file is the only one that should ever be checked in.

# ─────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────
# Use "production" on a real deployment — this also switches the rate
# limiter to its stricter production ceiling and makes CORS_ORIGIN below
# actually enforced (in development, any origin is allowed).
NODE_ENV=development
PORT=5000
APP_NAME=HungerPoint

# ─────────────────────────────────────
# DATABASE
# ─────────────────────────────────────
# Local dev (WAMP/XAMPP MySQL, default root user with no password):
DATABASE_URL="mysql://root:@localhost:3306/hungerpointdb"
# Production: point this at a real managed/hosted MySQL instance with a
# real, non-empty password — never root with no password outside local dev.

# ─────────────────────────────────────
# JWT
# ─────────────────────────────────────
# These two are safe, working dev-only defaults — good enough to run
# locally, but regenerate BOTH before any real deployment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Always use two DIFFERENT random secrets — never reuse one for both.
JWT_SECRET=531279059f168c9928d1a42cbe7ba545c1f107136fed5f367da8dea197fa55cc5f5a1ecac9b005380c451b4a3bbf4710
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=84130ab66d2a38f5b4ea4da9311c1f2a6538e01ee9324f5a03bee6075aed659c6f8d514843ce889377d26bbf4173688a
JWT_REFRESH_EXPIRES_IN=30d

# ─────────────────────────────────────
# CORS
# ─────────────────────────────────────
# Local dev: http://localhost:3000,http://localhost:3001
# Production: the real domain(s) hpweb is served from, comma-separated,
# e.g. https://admin.hungerpoint.pk — no localhost, no wildcards.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────
# SOCKET.IO
# ─────────────────────────────────────
# Same rule as CORS_ORIGIN above — the real domain(s) in production.
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────
# Optional — the app already picks a sane default itself (100 req/window
# in production, 2000 in development) based on NODE_ENV above. Uncomment
# only to override that default.
RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# ─────────────────────────────────────
# TWILIO (Real SMS delivery for OTP) — optional. Without these, OTPs are
# just logged to the server console instead of texted to a real phone
# ("[SMS GATEWAY SIMULATION]") — fine for dev, needed for production.
# ─────────────────────────────────────
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_from_number
